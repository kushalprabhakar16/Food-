import { useState } from 'react';
import { Link, useLocation, useNavigate } from 'react-router-dom';
import { useAuth } from '@/context/AuthContext';
import {
  LayoutDashboard,
  FilePlus,
  Search,
  Users,
  Settings,
  MapPin,
  GitBranch,
  BarChart3,
  Shield,
  LogOut,
  Menu,
  X,
  UserCircle,
  ClipboardList,
  Cpu,
  FileText,
  ScrollText,
  Building2,
  ChevronRight,
} from 'lucide-react';
import { UserRole } from '@/lib/supabase';

interface NavItem {
  label: string;
  path: string;
  icon: typeof LayoutDashboard;
  roles: UserRole[];
}

const NAV_ITEMS: NavItem[] = [
  { label: 'Dashboard', path: '/dashboard', icon: LayoutDashboard, roles: ['administrator', 'inspector', 'district_officer', 'deputy_officer', 'general_user'] },
  { label: 'Submit Report', path: '/reports/submit', icon: FilePlus, roles: ['administrator', 'inspector'] },
  { label: 'Report Tracking', path: '/reports/track', icon: Search, roles: ['administrator', 'inspector', 'district_officer', 'deputy_officer', 'general_user'] },
  { label: 'My Reports', path: '/my-reports', icon: ClipboardList, roles: ['inspector'] },
  { label: 'Handler Dashboard', path: '/handler', icon: Shield, roles: ['district_officer', 'deputy_officer', 'administrator'] },
  { label: 'Analytics', path: '/analytics', icon: BarChart3, roles: ['administrator', 'district_officer'] },
  { label: 'Routing Management', path: '/routing', icon: GitBranch, roles: ['administrator'] },
  { label: 'Officer Management', path: '/officers', icon: Users, roles: ['administrator'] },
  { label: 'Zone Management', path: '/zones', icon: MapPin, roles: ['administrator'] },
  { label: 'DFA Visualization', path: '/dfa', icon: Cpu, roles: ['administrator', 'inspector', 'general_user'] },
  { label: 'Classification Engine', path: '/classification', icon: FileText, roles: ['administrator', 'inspector'] },
  { label: 'Audit Logs', path: '/audit-logs', icon: ScrollText, roles: ['administrator'] },
  { label: 'User Management', path: '/users', icon: Building2, roles: ['administrator'] },
  { label: 'Profile', path: '/profile', icon: UserCircle, roles: ['administrator', 'inspector', 'district_officer', 'deputy_officer', 'general_user'] },
  { label: 'Settings', path: '/settings', icon: Settings, roles: ['administrator', 'inspector', 'district_officer', 'deputy_officer', 'general_user'] },
];

const ROLE_LABELS: Record<UserRole, string> = {
  administrator: 'Administrator',
  inspector: 'Food Inspector',
  district_officer: 'District Regulatory Officer',
  deputy_officer: 'Deputy Officer',
  general_user: 'General User',
};

interface DashboardLayoutProps {
  children: React.ReactNode;
}

export function DashboardLayout({ children }: DashboardLayoutProps) {
  const { user, signOut } = useAuth();
  const location = useLocation();
  const navigate = useNavigate();
  const [sidebarOpen, setSidebarOpen] = useState(false);

  if (!user) return null;

  const visibleItems = NAV_ITEMS.filter((item) => item.roles.includes(user.role));

  const handleSignOut = async () => {
    await signOut();
    navigate('/login');
  };

  const isActive = (path: string) => {
    if (path === '/dashboard') return location.pathname === '/dashboard';
    return location.pathname.startsWith(path);
  };

  return (
    <div className="min-h-screen bg-navy-50 flex">
      {/* Sidebar - Desktop */}
      <aside
        className={`fixed lg:sticky top-0 left-0 h-screen w-64 bg-navy-900 text-white flex flex-col z-50 transition-transform duration-300 ${
          sidebarOpen ? 'translate-x-0' : '-translate-x-full lg:translate-x-0'
        }`}
      >
        {/* Logo Header */}
        <div className="px-4 py-5 border-b border-navy-800">
          <div className="flex items-center gap-2.5">
            <div className="w-9 h-9 rounded-lg bg-lightblue-600 flex items-center justify-center flex-shrink-0">
              <Shield size={20} className="text-white" />
            </div>
            <div className="min-w-0">
              <h2 className="text-sm font-bold leading-tight truncate">FOOD SAFETY</h2>
              <p className="text-xs text-navy-300 leading-tight">Inspection Portal</p>
            </div>
          </div>
        </div>

        {/* User Info */}
        <div className="px-4 py-3 border-b border-navy-800">
          <div className="flex items-center gap-2.5">
            <div className="w-8 h-8 rounded-full bg-lightblue-700 flex items-center justify-center text-sm font-bold flex-shrink-0">
              {user.full_name.charAt(0).toUpperCase()}
            </div>
            <div className="min-w-0">
              <p className="text-sm font-medium truncate">{user.full_name}</p>
              <p className="text-xs text-navy-300 truncate">{ROLE_LABELS[user.role]}</p>
            </div>
          </div>
        </div>

        {/* Navigation */}
        <nav className="flex-1 overflow-y-auto px-3 py-3 space-y-1">
          {visibleItems.map((item) => {
            const Icon = item.icon;
            return (
              <Link
                key={item.path}
                to={item.path}
                onClick={() => setSidebarOpen(false)}
                className={`sidebar-link ${isActive(item.path) ? 'sidebar-link-active' : ''}`}
              >
                <Icon size={18} className="flex-shrink-0" />
                <span className="truncate">{item.label}</span>
                {isActive(item.path) && <ChevronRight size={16} className="ml-auto" />}
              </Link>
            );
          })}
        </nav>

        {/* Logout */}
        <div className="px-3 py-3 border-t border-navy-800">
          <button
            onClick={handleSignOut}
            className="sidebar-link w-full text-left text-red-300 hover:bg-navy-800 hover:text-red-200"
          >
            <LogOut size={18} />
            <span>Sign Out</span>
          </button>
        </div>
      </aside>

      {/* Mobile overlay */}
      {sidebarOpen && (
        <div
          className="fixed inset-0 bg-black/50 z-40 lg:hidden"
          onClick={() => setSidebarOpen(false)}
        />
      )}

      {/* Main Content */}
      <div className="flex-1 min-w-0 flex flex-col">
        {/* Top bar */}
        <header className="bg-white border-b border-navy-100 px-4 py-3 flex items-center justify-between sticky top-0 z-30">
          <div className="flex items-center gap-3">
            <button
              onClick={() => setSidebarOpen(!sidebarOpen)}
              className="lg:hidden p-1.5 rounded-lg hover:bg-navy-50"
            >
              {sidebarOpen ? <X size={22} /> : <Menu size={22} />}
            </button>
            <div className="hidden sm:block">
              <p className="text-sm font-medium text-navy-700">
                Smart Inspection, Intelligent Classification & Automated Case Dispatch
              </p>
            </div>
          </div>
          <div className="flex items-center gap-2">
            <span className="text-xs text-navy-400 hidden sm:block">{new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' })}</span>
            <div className="w-8 h-8 rounded-full bg-navy-900 flex items-center justify-center text-white text-sm font-bold">
              {user.full_name.charAt(0).toUpperCase()}
            </div>
          </div>
        </header>

        {/* Page content */}
        <main className="flex-1 p-4 lg:p-6 overflow-x-hidden">
          <div className="max-w-7xl mx-auto">{children}</div>
        </main>
      </div>
    </div>
  );
}
