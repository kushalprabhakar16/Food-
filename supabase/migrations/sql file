/*
# Food Safety Inspection Portal — Core Schema

This migration creates the complete database schema for the Food Safety Inspection Portal,
a government-grade inspection management system with automated validation, classification,
routing, and dispatch capabilities.

## New Tables

1. `users` — Portal user accounts. Roles: administrator, inspector, district_officer, deputy_officer, general_user.
2. `officers` — Regulatory officer records (district + deputy). Tracks zone assignment, capacity, current workload, availability.
3. `zones` — Six configurable PIN-code routing zones.
4. `pin_code_mappings` — Individual PIN-code → zone mappings.
5. `deputy_officers` — Deputy officer pool zone fallback assignments.
6. `reports` — Inspection reports with validation, classification, priority, zone, assignment, status.
7. `classifications` — Classification history per report.
8. `assignments` — Report-to-officer assignment records.
9. `status_history` — Full status transition log.
10. `routing_logs` — Audit trail for routing decisions.
11. `audit_logs` — System-wide audit log.

## Security
- RLS enabled on all tables. Grants to `authenticated`. Shared operational data with authenticated access.
*/

-- USERS
CREATE TABLE IF NOT EXISTS users (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  auth_id uuid REFERENCES auth.users(id) ON DELETE CASCADE,
  email text UNIQUE NOT NULL,
  full_name text NOT NULL,
  role text NOT NULL CHECK (role IN ('administrator', 'inspector', 'district_officer', 'deputy_officer', 'general_user')),
  inspector_id text UNIQUE,
  contact text,
  availability text DEFAULT 'available' CHECK (availability IN ('available', 'unavailable', 'on_leave')),
  created_at timestamptz DEFAULT now(),
  updated_at timestamptz DEFAULT now()
);
ALTER TABLE users ENABLE ROW LEVEL SECURITY;
GRANT SELECT, INSERT, UPDATE, DELETE ON users TO authenticated;
GRANT SELECT, INSERT, UPDATE, DELETE ON users TO service_role;
DROP POLICY IF EXISTS "users_select_all" ON users;
CREATE POLICY "users_select_all" ON users FOR SELECT TO authenticated USING (true);
DROP POLICY IF EXISTS "users_insert_own" ON users;
CREATE POLICY "users_insert_own" ON users FOR INSERT TO authenticated WITH CHECK (auth.uid() = auth_id);
DROP POLICY IF EXISTS "users_update_own" ON users;
CREATE POLICY "users_update_own" ON users FOR UPDATE TO authenticated USING (auth.uid() = auth_id) WITH CHECK (auth.uid() = auth_id);

